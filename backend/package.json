{
  "name": "practice-tracker-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Серверна частина ІС обліку та контролю проходження студентами виробничої практики «Трекер Практики»",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-db": "node src/initDb.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:functional": "node --test tests/functional.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:patterns": "node --test tests/patterns-*.test.js",
    "demo:patterns": "node scripts/demo_patterns.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

{
  "name": "practice-tracker-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Фронтенд ІС обліку та контролю проходження студентами виробничої практики",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "npm --prefix ../backend start",
    "dev:mock": "concurrently -k -n MOCK,WEB -c yellow,cyan \"npm:mock\" \"npm:web\"",
    "mock": "json-server --watch mock-api/db.json --port 3001 --delay 250",
    "reset-api": "node -e \"require('fs').copyFileSync('mock-api/db.seed.json','mock-api/db.json'); console.log('mock-api/db.json скинуто до початкових даних')\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "json-server": "0.17.4",
    "vite": "^5.4.8"
  }
}